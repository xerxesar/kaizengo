# Postgres server connection (host/user/password). The DB name in the path is a
# default used to seed .kaizengo/databases.json on first start; the catalog only
# stores database names + selection + master password hash — not connection info.
KaizenGo_POSTGRES_DSN=postgres://kaizengo:kaizengo@localhost:6432/kaizengo?sslmode=disable

# Optional: path to the file-backed DB catalog (default .kaizengo/databases.json).
# Set NEW_PASSWORD in that JSON to auto-hash a master password on load.
# KaizenGo_DATABASES_CONFIG=.kaizengo/databases.json

KaizenGo_TYPESENSE_URL=http://localhost:6108
KaizenGo_TYPESENSE_API_KEY=kaizengo-dev-key
