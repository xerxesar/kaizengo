{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run KaizenGo Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-kaizengo",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode-kaizengo/out/**/*.js"],
      "preLaunchTask": "vscode-kaizengo: compile"
    }
  ]
}
