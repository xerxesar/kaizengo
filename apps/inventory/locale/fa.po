msgid "inventory.overview.about_title"
msgstr "موجودی چگونه نگه داشته می‌شود"

msgid "inventory.overview.about"
msgstr "مقدار موجودی تصویر دفتر کل دوطرفه و تغییرناپذیر است. رسید، تحویل، انتقال، تعدیل و مرجوعی سطر بدهکار و بستانکار می‌زنند. ارزش‌گذاری از روش بهای تمام‌شده هر محصول پیروی می‌کند. تکمیل عملیات سند را ثبت می‌کند؛ سطرهای دفتر دستی ویرایش نمی‌شوند."

msgid "inventory.products.title"
msgstr "محصولات"

msgid "inventory.products.subtitle"
msgstr "قالب با ردیابی، روش بها، و استراتژی خروج. تنوع‌ها SKUهایی هستند که انبار می‌کنید."

msgid "inventory.variants.title"
msgstr "SKU / تنوع"

msgid "inventory.variants.subtitle"
msgstr "واحد خرید، انبار و فروش، بارکد (UPC/EAN)، و بهای استاندارد."

msgid "inventory.uom_groups.title"
msgstr "گروه واحد"

msgid "inventory.uom_groups.subtitle"
msgstr "تبدیل فقط داخل یک گروه (تعداد، وزن، حجم) مجاز است."

msgid "inventory.uoms.title"
msgstr "واحد اندازه‌گیری"

msgid "inventory.uoms.subtitle"
msgstr "نسبت یعنی چند واحد مرجع در این واحد است (دوجین = ۱۲)."

msgid "inventory.attributes.title"
msgstr "ویژگی‌ها"

msgid "inventory.attributes.subtitle"
msgstr "ویژگی پویای کاتالوگ (رنگ، اندازه، درجه) برای تنوع محصول."

msgid "inventory.attribute_values.title"
msgstr "مقادیر ویژگی"

msgid "inventory.attribute_values.subtitle"
msgstr "مقادیر مجاز برای ویژگی انتخابی."

msgid "inventory.locations.title"
msgstr "محل‌ها"

msgid "inventory.locations.subtitle"
msgstr "از انبار تا خانه، به‌علاوه محل‌های مجازی تأمین‌کننده، مشتری، ترانزیت، ضایعات و تعدیل."

msgid "inventory.locations.tree"
msgstr "سلسله‌مراتب"

msgid "inventory.locations.add"
msgstr "افزودن محل"

msgid "inventory.locations.detail"
msgstr "محل"

msgid "inventory.locations.count"
msgstr "%d محل"

msgid "inventory.stock.title"
msgstr "موجودی"

msgid "inventory.stock.subtitle"
msgstr "مانده بر اساس SKU، محل و لات. مقدار تحت کنترل دفتر است."

msgid "inventory.lots.title"
msgstr "لات / بچ"

msgid "inventory.lots.subtitle"
msgstr "تاریخ انقضا و تولید برای FEFO و فراخوانی."

msgid "inventory.serials.title"
msgstr "شماره سریال"

msgid "inventory.serials.subtitle"
msgstr "هویت سرتاسری کالای سریالی."

msgid "inventory.operations.title"
msgstr "عملیات انبار"

msgid "inventory.operations.subtitle"
msgstr "عملیات بسازید، حرکت اضافه کنید، سپس وضعیت را «انجام‌شده» کنید تا دفتر ثبت شود."

msgid "inventory.operations.header"
msgstr "عملیات"

msgid "inventory.operations.hint"
msgstr "پیش‌نویس → تخصیص (رزرو) → انجام‌شده (ثبت بدهکار/بستانکار). عملیات لغوشده قابل تکمیل نیست."

msgid "inventory.moves.title"
msgstr "حرکت موجودی"

msgid "inventory.moves.hint"
msgstr "هر سطر محل مبدأ را بستانکار و مقصد را بدهکار می‌کند. کالای لات‌دار به لات و کالای سریالی به سریال نیاز دارد."

msgid "inventory.receipts.title"
msgstr "رسید"

msgid "inventory.receipts.subtitle"
msgstr "ورود کالا: مبدأ سفارش خرید، وضعیت کنترل کیفیت اختیاری، سپس تکمیل برای جانمایی."

msgid "inventory.fulfillment.title"
msgstr "خروج"

msgid "inventory.fulfillment.subtitle"
msgstr "برداشت خروجی. موج و دسته را روی عملیات برای برداشت موجی/ناحیه‌ای/دسته‌ای بگذارید."

msgid "inventory.transfers.title"
msgstr "انتقال داخلی"

msgid "inventory.transfers.subtitle"
msgstr "جابجایی بین محل‌ها یا انبارها. محل ترانزیت موجودی در راه را نگه می‌دارد."

msgid "inventory.adjustments.title"
msgstr "تعدیل و شمارش"

msgid "inventory.adjustments.subtitle"
msgstr "مقدار شمارش‌شده را بگذارید و «انجام‌شده» کنید. اختلاف به محل تعدیل موجودی می‌رود."

msgid "inventory.returns.title"
msgstr "مرجوعی / RMA"

msgid "inventory.returns.subtitle"
msgstr "وضعیت «دریافت‌شده» موجودی را برمی‌گرداند. تعیین تکلیف: موجودی مجدد، تعمیر، قرنطینه، ضایعات یا فقط اعتبار."

msgid "inventory.planning.title"
msgstr "قواعد سفارش مجدد"

msgid "inventory.planning.subtitle"
msgstr "موجودی ایمنی: نقطه سفارش = تقاضا × زمان تأمین + موجودی ایمنی. حداقل/حداکثر از حداقل به‌عنوان نقطه سفارش استفاده می‌کند. پیش‌بینی تا اتصال خوراک تاریخچه تقاضا همان مدل زمان تأمین را به کار می‌برد."

msgid "inventory.ledger.title"
msgstr "دفتر موجودی"

msgid "inventory.ledger.subtitle"
msgstr "سطرهای بدهکار و بستانکار تغییرناپذیر؛ مسیر حسابرسی مقدار و ارزش."

msgid "inventory.cost_layers.title"
msgstr "لایه‌های هزینه"

msgid "inventory.cost_layers.subtitle"
msgstr "لایه‌های FIFO/LIFO/میانگین که در ورود ساخته و در خروج مصرف می‌شوند."

msgid "inventory.hardware.title"
msgstr "دستگاه‌های انبار"

msgid "inventory.hardware.subtitle"
msgstr "ثبت اسکنر بارکد، خواننده RFID، اپ موبایل و حسگر MQTT/بلوتوث. جفت‌سازی و تله‌متری نقطه توسعه است."

msgid "inventory.integrations.title"
msgstr "یکپارچه‌سازی"

msgid "inventory.integrations.subtitle"
msgstr "وب‌هوک و کانکتور ERP (SAP، NetSuite، Odoo، فروشگاه، CRM). ارسال رویداد از دفتر موجودی است."

