{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run KaizenGo Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "vscode-kaizengo: compile"
    }
  ]
}
